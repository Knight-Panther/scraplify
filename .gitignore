# Secrets and local environment
.env
.env.*
# ...but the QA profile TEMPLATE is committed: it carries no real credential
# and it is the only written record of how the disposable database is made.
!.env.qa.example
!.env.example
.mcp.json

# JavaScript / TypeScript
node_modules/
dist/
build/
coverage/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs and temporary files
*.log
tmp/
temp/

# Generated Playwright MCP state captures (can contain page content/PII)
.playwright-mcp/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Machine-local Claude settings
.claude/settings.local.json

# Next.js build output and caches (web/)
web/.next/
web/out/
web/.turbo/
next-env.d.ts
web/tsconfig.tsbuildinfo

# Playwright e2e output (traces, HTML report) — reproducible, not source
test-results/
playwright-report/
blob-report/

# Database backups (scripts/backup-db.ps1) - real corpus data, never committed
backups/

# Self-hosted matching-model cache (Phase 8A) — large binaries (100MB+),
# never committed; vendored locally by scripts/vendor-matching-model.mjs and
# verified against the hashes pinned in src/matching/models/.
.matching-models/

# Published matching bundles (Phase 8C) — generated by `npm run matching:build`
# from the local database; XTELO_MATCHING_ARTIFACT_DIR can move them.
.matching-artifacts/

# Build artifact, not source (scripts/matching-parity/bundle-worker.mjs
# regenerates it from worker.mjs) — run that before scripts/matching-parity/check.mjs.
scripts/matching-parity/worker.bundle.mjs

# Local research spikes: large model files and private eval data (the
# owner's CV). Results that matter are recorded in docs/STATUS.md.
spike/
