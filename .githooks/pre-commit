#!/usr/bin/env sh

# Review the working tree before a commit. Codex has no staged-only review
# target, so this includes staged, unstaged, and untracked changes.
set -u

if git diff --cached --quiet; then
  exit 0
fi

# Non-blocking reminder: nudge toward keeping docs/STATUS.md in sync with
# work that changes phase/exit-gate progress. This is a deterministic file
# check only — it cannot judge whether a status update was actually needed,
# so it never blocks the commit.
if ! git diff --cached --name-only | grep -qx 'docs/STATUS.md'; then
  echo "pre-commit: reminder — docs/STATUS.md was not updated in this commit." >&2
  echo "  If this work changes phase/exit-gate progress, update it (stage it too) before committing." >&2
  echo "  Not every commit needs this — ignore if this one genuinely doesn't affect tracked status." >&2
fi

# Blocking: implementation work belongs on a phase branch, not main (see
# the Git workflow section in CLAUDE.md). This only checks the branch name
# and which files are staged, not intent — a genuine governance/doc change
# on main is still allowed, since it's excluded from the path check below.
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$current_branch" = "main" ]; then
  non_governance_files=$(git diff --cached --name-only | grep -vE \
    '^(docs/|\.claude/|\.agents/|\.codex/|\.githooks/|scripts/|README\.md$|CLAUDE\.md$|AGENTS\.md$|\.gitignore$|\.gitattributes$)')
  if [ -n "$non_governance_files" ]; then
    suggested_slug=$(grep -m1 '^## Current phase:' docs/STATUS.md 2>/dev/null \
      | sed -E 's/^## Current phase: *//; s/[^A-Za-z0-9]+/-/g; s/^-+//; s/-+$//' \
      | tr '[:upper:]' '[:lower:]')
    echo "pre-commit: blocked — committing implementation files directly on main:" >&2
    echo "$non_governance_files" | sed 's/^/    /' >&2
    echo "  Implementation work happens on a phase branch (CLAUDE.md's Git workflow section)." >&2
    if [ -n "$suggested_slug" ]; then
      echo "  Suggested: git checkout -b $suggested_slug" >&2
    else
      echo "  Create one: git checkout -b phase-<name>" >&2
    fi
    echo "  If this really is a governance/doc change, it should already be excluded above — check the path filter." >&2
    exit 1
  fi
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "pre-commit: Codex CLI was not found on PATH; blocking commit." >&2
  echo "Install/configure Codex, then try the commit again." >&2
  exit 1
fi

review_log=$(mktemp "${TMPDIR:-/tmp}/scraplify-codex-log.XXXXXX") || {
  echo "pre-commit: could not create a temporary log file; blocking commit." >&2
  exit 1
}
review_result=$(mktemp "${TMPDIR:-/tmp}/scraplify-codex-result.XXXXXX") || {
  rm -f "$review_log"
  echo "pre-commit: could not create a temporary result file; blocking commit." >&2
  exit 1
}
trap 'rm -f "$review_log" "$review_result"' EXIT HUP INT TERM

echo "pre-commit: running Codex review of all uncommitted changes..."
if codex exec review --uncommitted --output-last-message "$review_result" >"$review_log" 2>&1; then
  review_status=0
else
  review_status=$?
fi

if [ "$review_status" -ne 0 ]; then
  cat "$review_log"
  echo "pre-commit: Codex review failed (exit $review_status); blocking commit." >&2
  exit 1
fi

cat "$review_result"

if grep -qE '\[P[01]\]' "$review_result"; then
  echo "pre-commit: Codex found P0/P1 blockers; fix them and try again." >&2
  exit 1
fi

echo "pre-commit: no P0/P1 blockers found."
exit 0
