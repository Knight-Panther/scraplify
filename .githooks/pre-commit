#!/usr/bin/env sh

# Review the working tree before a commit. Codex has no staged-only review
# target, so this includes staged, unstaged, and untracked changes.
set -u

if git diff --cached --quiet; then
  exit 0
fi

# Non-blocking reminder: nudge toward keeping docs/STATUS.md in sync with
# work that changes phase/exit-gate progress. This is a deterministic file
# check only — it cannot judge whether a status update was actually needed,
# so it never blocks the commit.
if ! git diff --cached --name-only | grep -qx 'docs/STATUS.md'; then
  echo "pre-commit: reminder — docs/STATUS.md was not updated in this commit." >&2
  echo "  If this work changes phase/exit-gate progress, update it (stage it too) before committing." >&2
  echo "  Not every commit needs this — ignore if this one genuinely doesn't affect tracked status." >&2
fi

# Blocking: implementation work belongs on a phase branch, not main (see
# the Git workflow section in CLAUDE.md). This only checks the branch name
# and which files are staged, not intent — a genuine governance/doc change
# on main is still allowed, since it's excluded from the path check below.
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$current_branch" = "main" ]; then
  non_governance_files=$(git diff --cached --name-only | grep -vE \
    '^(docs/|\.claude/|\.agents/|\.codex/|\.githooks/|scripts/|README\.md$|CLAUDE\.md$|AGENTS\.md$|\.gitignore$|\.gitattributes$)')
  if [ -n "$non_governance_files" ]; then
    suggested_slug=$(grep -m1 '^## Current phase:' docs/STATUS.md 2>/dev/null \
      | sed -E 's/^## Current phase: *//; s/[^A-Za-z0-9]+/-/g; s/^-+//; s/-+$//' \
      | tr '[:upper:]' '[:lower:]')
    echo "pre-commit: blocked — committing implementation files directly on main:" >&2
    echo "$non_governance_files" | sed 's/^/    /' >&2
    echo "  Implementation work happens on a phase branch (CLAUDE.md's Git workflow section)." >&2
    if [ -n "$suggested_slug" ]; then
      echo "  Suggested: git checkout -b $suggested_slug" >&2
    else
      echo "  Create one: git checkout -b phase-<name>" >&2
    fi
    echo "  If this really is a governance/doc change, it should already be excluded above — check the path filter." >&2
    exit 1
  fi
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "pre-commit: Codex CLI was not found on PATH; blocking commit." >&2
  echo "Install/configure Codex, then try the commit again." >&2
  exit 1
fi

# Self-managing usage-limit cooldown. Codex's own error names exactly when
# it resets ("try again at HH:MM AM/PM"); rather than re-discovering that
# out of the blue on every commit attempt in between (and needing a human
# to notice and reach for --no-verify each time), a cooldown file records
# it once and every subsequent commit checks it BEFORE even trying codex.
# Machine-local and gitignored on purpose — this is about one account's
# rate limit, not a fact about the repo. Self-expires: once now is past the
# recorded time, the file is stale and this falls through to a real
# attempt, which is what actually confirms Codex is back — no cron job or
# external scheduler needed, since a hook only ever needs to know "is it
# still in the future" at the moment someone commits.
# --git-common-dir, NOT --git-dir: this repo works across multiple worktrees
# (one per phase branch) simultaneously, and --git-dir resolves to each
# worktree's own PRIVATE .git/worktrees/<name>/ directory — a cooldown
# recorded there would only ever help future commits in that SAME worktree,
# defeating the point the moment more than one is active at once (found by
# testing across two worktrees in the same session that hit this exact
# codex outage, not assumed). --git-common-dir is the one location every
# worktree of this repo shares.
cooldown_file="$(git rev-parse --git-common-dir 2>/dev/null || echo .git)/codex-cooldown"
now_epoch=$(date +%s)

if [ -f "$cooldown_file" ]; then
  cooldown_until=$(cat "$cooldown_file" 2>/dev/null || echo 0)
  case "$cooldown_until" in
    ''|*[!0-9]*) cooldown_until=0 ;;
  esac
  if [ "$cooldown_until" -gt "$now_epoch" ]; then
    echo "pre-commit: Codex reported its usage limit exhausted until $(date -d "@$cooldown_until" '+%H:%M' 2>/dev/null || echo "$cooldown_until"); skipping the review for this commit rather than re-attempting a call already known to fail." >&2
    echo "pre-commit: recorded as owed if this touches application code — see docs/STATUS.md's existing convention for this." >&2
    exit 0
  fi
  rm -f "$cooldown_file"
fi

review_log=$(mktemp "${TMPDIR:-/tmp}/scraplify-codex-log.XXXXXX") || {
  echo "pre-commit: could not create a temporary log file; blocking commit." >&2
  exit 1
}
review_result=$(mktemp "${TMPDIR:-/tmp}/scraplify-codex-result.XXXXXX") || {
  rm -f "$review_log"
  echo "pre-commit: could not create a temporary result file; blocking commit." >&2
  exit 1
}
trap 'rm -f "$review_log" "$review_result"' EXIT HUP INT TERM

echo "pre-commit: running Codex review of all uncommitted changes..."
if codex exec review --uncommitted --output-last-message "$review_result" >"$review_log" 2>&1; then
  review_status=0
else
  review_status=$?
fi

if [ "$review_status" -ne 0 ]; then
  cat "$review_log"
  # A usage-limit exhaustion is a distinct failure mode from a real review
  # failure: record the cooldown so the NEXT commit doesn't have to
  # rediscover it, but this one still fails closed — recorded as owed and
  # committed --no-verify remains an explicit, visible decision, not an
  # automatic bypass on the first hit.
  #
  # Codex's own message has been seen in two shapes: a bare time when the
  # reset is later the same day ("try again at 1:26 PM"), and a full date
  # when it crosses midnight ("try again at Sep 16th, 2026 12:20 AM") —
  # found live, 2026-09-15, when the first shape's regex silently failed to
  # match the second and the cooldown went unrecorded (exactly the "out of
  # the blue" rediscovery this mechanism exists to prevent). Try the
  # date-qualified form first, since the bare-time regex would otherwise
  # also match the TIME portion embedded inside it and derive the wrong day.
  reset_full=$(grep -oE "try again at [A-Za-z]{3} [0-9]{1,2}(st|nd|rd|th)?, [0-9]{4} [0-9]{1,2}:[0-9]{2} ?[AP]M" "$review_log" | head -1 | sed -E 's/try again at //')
  if [ -n "$reset_full" ]; then
    # GNU date rejects an ordinal day suffix ("16th") outright — strip it,
    # keeping the day number, before parsing (confirmed by testing both
    # forms directly, not assumed).
    reset_epoch=$(date -d "$(echo "$reset_full" | sed -E 's/(st|nd|rd|th),/,/')" +%s 2>/dev/null || echo "")
    if [ -n "$reset_epoch" ]; then
      echo "$reset_epoch" >"$cooldown_file"
      echo "pre-commit: recorded a cooldown until $reset_full — future commits will skip re-attempting Codex until then." >&2
    fi
  else
    reset_time=$(grep -oE 'try again at [0-9]{1,2}:[0-9]{2} ?[AP]M' "$review_log" | head -1 | sed -E 's/try again at //')
    if [ -n "$reset_time" ]; then
      reset_epoch=$(date -d "today $reset_time" +%s 2>/dev/null || echo "")
      if [ -n "$reset_epoch" ]; then
        if [ "$reset_epoch" -le "$now_epoch" ]; then
          reset_epoch=$(date -d "tomorrow $reset_time" +%s 2>/dev/null || echo "")
        fi
        if [ -n "$reset_epoch" ]; then
          echo "$reset_epoch" >"$cooldown_file"
          echo "pre-commit: recorded a cooldown until $reset_time — future commits will skip re-attempting Codex until then." >&2
        fi
      fi
    fi
  fi
  echo "pre-commit: Codex review failed (exit $review_status); blocking commit." >&2
  exit 1
fi

cat "$review_result"

if grep -qE '\[P[01]\]' "$review_result"; then
  echo "pre-commit: Codex found P0/P1 blockers; fix them and try again." >&2
  exit 1
fi

echo "pre-commit: no P0/P1 blockers found."
exit 0
