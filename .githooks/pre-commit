#!/usr/bin/env sh

# Two checks before a commit: a non-blocking STATUS.md reminder, and a
# blocking rule that implementation work stays off main.
#
# There is no automatic Codex review here any more. Since 2026-10-05 Codex
# reviews are manual only (owner decision, docs/STATUS.md "Owner decisions
# in force"): run `/codex:review` or `/codex:adversarial-review` when asked.
set -u

if git diff --cached --quiet; then
  exit 0
fi

# Non-blocking reminder: nudge toward keeping docs/STATUS.md in sync with
# work that changes phase/exit-gate progress. This is a deterministic file
# check only — it cannot judge whether a status update was actually needed,
# so it never blocks the commit.
if ! git diff --cached --name-only | grep -qx 'docs/STATUS.md'; then
  echo "pre-commit: reminder — docs/STATUS.md was not updated in this commit." >&2
  echo "  If this work changes phase/exit-gate progress, update it (stage it too) before committing." >&2
  echo "  Not every commit needs this — ignore if this one genuinely doesn't affect tracked status." >&2
fi

# Non-blocking: the Board at the top of docs/STATUS.md and an active plan
# tracker (docs/PHASE_*_PLAN.md) move in the same commit as the STATUS gate
# they follow (CLAUDE.md, "Tracking"). File and line checks only, so it
# reminds and never blocks.
if git diff --cached --name-only | grep -qx 'docs/STATUS.md'; then
  staged=$(git diff --cached --name-only)
  for plan in docs/PHASE_*_PLAN.md; do
    [ -f "$plan" ] || continue
    # A plan saved for later says "Not started." in its first lines; nothing
    # in STATUS moves its items yet, so it is left out until it starts.
    head -n 8 "$plan" | grep -q 'Not started\.' && continue
    if ! printf '%s\n' "$staged" | grep -qx "$plan"; then
      echo "pre-commit: reminder — docs/STATUS.md changed but $plan did not." >&2
      echo "  If this commit moves one of its items, mark it there too (CLAUDE.md, \"Tracking\")." >&2
    fi
  done
  # A box ticked in this commit, with no change between the Board's markers.
  if git diff --cached -U0 -- docs/STATUS.md | grep -q '^+.*- \[x\]'; then
    board=$(git show :docs/STATUS.md 2>/dev/null \
      | awk '/<!-- board:start -->/ { s = NR } /<!-- board:end -->/ { e = NR } END { if (s && e) print s, e }')
    if [ -n "$board" ]; then
      touched=$(git diff --cached -U0 -- docs/STATUS.md | awk -v board="$board" '
        BEGIN { split(board, b, " ") }
        /^@@/ {
          split($3, n, ",")
          first = substr(n[1], 2) + 0
          count = (n[2] == "") ? 1 : n[2] + 0
          last = (count == 0) ? first : first + count - 1
          if (first <= b[2] && last >= b[1]) hit = 1
        }
        END { print hit + 0 }')
      if [ "$touched" = 0 ]; then
        echo "pre-commit: reminder — a gate was ticked in docs/STATUS.md but the Board at its top was not touched." >&2
        echo "  Move that item's row too (CLAUDE.md, \"Tracking\")." >&2
      fi
    fi
  fi
fi

# Blocking: implementation work belongs on a phase branch, not main (see
# the Git workflow section in CLAUDE.md). This only checks the branch name
# and which files are staged, not intent — a genuine governance/doc change
# on main is still allowed, since it's excluded from the path check below.
current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$current_branch" = "main" ]; then
  non_governance_files=$(git diff --cached --name-only | grep -vE \
    '^(docs/|\.claude/|\.agents/|\.codex/|\.githooks/|scripts/|README\.md$|LICENSE$|CLAUDE\.md$|AGENTS\.md$|\.gitignore$|\.gitattributes$)')
  if [ -n "$non_governance_files" ]; then
    suggested_slug=$(grep -m1 '^## Current phase:' docs/STATUS.md 2>/dev/null \
      | sed -E 's/^## Current phase: *//; s/[^A-Za-z0-9]+/-/g; s/^-+//; s/-+$//' \
      | tr '[:upper:]' '[:lower:]')
    echo "pre-commit: blocked — committing implementation files directly on main:" >&2
    echo "$non_governance_files" | sed 's/^/    /' >&2
    echo "  Implementation work happens on a phase branch (CLAUDE.md's Git workflow section)." >&2
    if [ -n "$suggested_slug" ]; then
      echo "  Suggested: git checkout -b $suggested_slug" >&2
    else
      echo "  Create one: git checkout -b phase-<name>" >&2
    fi
    echo "  If this really is a governance/doc change, it should already be excluded above — check the path filter." >&2
    exit 1
  fi
fi

exit 0
