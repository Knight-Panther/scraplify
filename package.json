{
  "name": "scraplify",
  "version": "0.0.0",
  "private": true,
  "description": "Xtelo: job/opportunity aggregator for jobs.ge and hr.ge.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Knight-Panther/scraplify.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Knight-Panther/scraplify/issues"
  },
  "homepage": "https://github.com/Knight-Panther/scraplify#readme",
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  }
}
