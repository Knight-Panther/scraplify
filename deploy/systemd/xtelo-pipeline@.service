# One scheduled crawl pipeline run for a source (Phase 8E): crawl, dedupe,
# taxonomy, then the matching bundle. The same steps and exit rules as
# scripts/run-crawl.ps1 on the Windows operator machine; see
# deploy/run-pipeline.sh. Triggered by xtelo-pipeline@<source>.timer.

[Unit]
Description=Xtelo crawl pipeline (%i)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
# The Hermes hook (docs/hermes-hook.md): however the run ended, send the event
# it left in the outbox. A stopped or timed-out run counts as failed here.
# Naming the same unit twice makes systemd log "multiple trigger source
# candidates for exit status propagation ... skipping", which is harmless: the
# sender does not read the run's result from systemd, it reads the outbox.
OnSuccess=xtelo-hermes-notify.service
OnFailure=xtelo-hermes-notify.service

[Service]
Type=oneshot
User=xtelo
Group=xtelo
WorkingDirectory=/opt/xtelo/current
EnvironmentFile=/etc/xtelo/worker.env
ExecStart=/opt/xtelo/current/deploy/run-pipeline.sh %i
# A crawl can run for hours; never let two overlap (the crawler's own run
# lock refuses a second one anyway).
TimeoutStartSec=12h

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectProc=invisible
InaccessiblePaths=-/etc/xtelo -/var/backups/xtelo
# The bundle builder's output is its only write; its output goes to the
# journal. systemd refuses to start the unit if this directory is missing
# (RUNBOOK §2 step 0 creates it).
ReadWritePaths=/var/lib/xtelo/bundles
# The Hermes outbox, optional ("-"): a host where it was never created must
# still crawl. The event is then not written, which the run's journal says.
ReadWritePaths=-/var/lib/xtelo/hermes/outbox
