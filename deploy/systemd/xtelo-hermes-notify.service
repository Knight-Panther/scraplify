# Sends what is waiting in the Hermes outbox (docs/hermes-hook.md): one event
# per finished pipeline run, to Hermes on the owner's PC. Started by
# xtelo-pipeline@<source>.service when a run ends (its OnSuccess= and
# OnFailure=), and by xtelo-hermes-notify.timer to retry while Hermes is
# unreachable, which is normal: the PC may be off for hours.
#
# It holds the hook's secrets and no database credential; the pipeline holds
# the database credential and no hook secret. That only holds because the two
# run as different users: one user's processes can read each other's
# environment through /proc (the reason xtelo-web@ has a user per surface),
# and the pipeline is the process that reads pages from the open web.

[Unit]
Description=Xtelo events to Hermes
After=network-online.target
Wants=network-online.target
# Nothing waiting, nothing to do: the unit is skipped and no process starts
# (the journal gets one "skipped" line). Dead events are kept beside the
# outbox, not inside it, so that this stays true.
ConditionDirectoryNotEmpty=/var/lib/xtelo/hermes/outbox

[Service]
Type=oneshot
User=xtelo-hermes
Group=xtelo-hermes
WorkingDirectory=/opt/xtelo/current
# Optional ("-"): the release is deployed before Hermes' side exists. Without
# the file the sender keeps every event and says the hook is not set up.
EnvironmentFile=-/etc/xtelo/hermes-hook.env
ExecStart=/usr/bin/node /opt/xtelo/current/dist/cli/hermes-notify.js
# One request waits 20 s at most, and the sender stops at the first event
# Hermes does not take.
TimeoutStartSec=10min

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectProc=invisible
InaccessiblePaths=-/etc/xtelo -/var/backups/xtelo
# The outbox (written by xtelo, group xtelo-hermes) and the dead events
# (xtelo-hermes only), through their parent: each writable path is
# a mount of its own here, and a refused event is moved from one to the other
# by a rename, which cannot cross mounts. Optional ("-") like the pipeline's:
# see xtelo-pipeline@.service.
ReadWritePaths=-/var/lib/xtelo/hermes
