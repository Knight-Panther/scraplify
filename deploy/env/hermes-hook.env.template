# /etc/xtelo/hermes-hook.env — the Hermes hook's sender (xtelo-hermes-notify).
# Mode 0600, owner root (systemd reads it before starting the unit).
# Placeholders only: never commit a real value.
#
# Written by deploy/set-hermes-hook.sh from hidden input, not by
# deploy/make-env.sh: until it exists the sender keeps every event unsent.
# It holds no database credential, and worker.env holds none of these. The
# sender runs as its own user (xtelo-hermes), so the pipeline cannot read
# these values out of its process either.

# Hermes' webhook route, behind a Cloudflare Tunnel and Access. https only.
HERMES_HOOK_URL=https://<HOOK_HOST>/webhooks/<ROUTE>

# The route's HMAC secret: each request is signed with it, over a timestamp
# and the body (docs/hermes-hook.md).
HERMES_HOOK_SECRET=<WEBHOOK_HMAC_SECRET>

# The Cloudflare Access service token that lets this host through.
CF_ACCESS_CLIENT_ID=<ACCESS_CLIENT_ID>.access
CF_ACCESS_CLIENT_SECRET=<ACCESS_CLIENT_SECRET>
