# /etc/xtelo/worker.env — the crawl pipeline (xtelo-pipeline@<source>).
# Mode 0600, owner root (systemd reads it before starting the unit).
# Placeholders only: never commit a real value.

# scraplify_worker only (scripts/sql/phase-8b-worker-admin-migration-roles.sql).
# deploy/apply-db-roles.sh creates the role with this password: letters and
# digits only (openssl rand -hex 32).
DATABASE_URL=postgres://scraplify_worker:<WORKER_ROLE_PASSWORD>@<DB_HOST>:5432/scraplify

# Where the bundle builder writes; the public process reads the same directory.
XTELO_MATCHING_ARTIFACT_DIR=/var/lib/xtelo/bundles

# The pinned title-vector model the bundle builder embeds with, outside the
# release so it survives deploys. Filled once by `npm run matching:vendor-model`.
XTELO_MATCHING_MODEL_DIR=/var/lib/xtelo/models

# Identifies the crawler to jobs.ge and hr.ge, with a contact address.
SCRAPLIFY_USER_AGENT=<USER_AGENT_WITH_CONTACT>

LOG_LEVEL=info

# The Hermes hook (docs/hermes-hook.md). Off unless this is exactly 1: each
# finished run then leaves one event in /var/lib/xtelo/hermes/outbox for
# xtelo-hermes-notify to send. The hook's secrets are not here; they are in
# hermes-hook.env, which the pipeline never reads.
# HERMES_HOOK_ENABLED=1
