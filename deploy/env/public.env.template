# /etc/xtelo/public.env — the public web process (xtelo-web@public).
# Mode 0600, owner root (systemd reads it before starting the unit).
# Placeholders only: never commit a real value.
#
# It refuses to start (web/lib/startup-checks.ts) without a bundle directory,
# with any admin credential below present, or if this database role can
# write to any table.

XTELO_SURFACE=public
XTELO_PORT=3000

# scraplify_public only (scripts/sql/phase-8b-public-role.sql): read-only views.
# Letters and digits only (openssl rand -hex 32); see deploy/apply-db-roles.sh.
DATABASE_URL=postgres://scraplify_public:<PUBLIC_ROLE_PASSWORD>@<DB_HOST>:5432/scraplify

# Written by the worker's bundle builder, read here.
XTELO_MATCHING_ARTIFACT_DIR=/var/lib/xtelo/bundles

LOG_LEVEL=info

# Never here: AUTH_SECRET, AUTH_GITHUB_SECRET, ADMIN_GITHUB_IDS, XTELO_WRITES_ENABLED,
# XTELO_E2E_ALLOW_WRITABLE_PUBLIC_ROLE.
