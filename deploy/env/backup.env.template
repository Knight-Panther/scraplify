# /etc/xtelo/backup.env — the nightly backup (xtelo-backup).
# Mode 0600, owner root (systemd reads it before starting the unit).
# Placeholders only: never commit a real value.

# scraplify_backup: reads every table (pg_read_all_data), writes nothing.
# deploy/apply-db-roles.sh creates it with this password: letters and digits
# only (openssl rand -hex 32).
BACKUP_DATABASE_URL=postgres://scraplify_backup:<BACKUP_ROLE_PASSWORD>@<DB_HOST>:5432/scraplify
BACKUP_DIR=/var/backups/xtelo
BACKUP_RETENTION_COUNT=14

# Off-host copy (deploy/backup-db.sh). An rclone remote defined entirely here,
# with no rclone config file. Example for Cloudflare R2: a private bucket and
# an API token scoped to Object Read & Write on that bucket only. Old copies
# expire by the bucket's lifecycle rule: delete after 30 days (RUNBOOK §6).
BACKUP_REMOTE=offsite:<BUCKET>/xtelo
# The off-host copies are also kept under this many bytes, oldest deleted
# first (default 8 GB, below R2's 10 GB-month free tier).
# BACKUP_REMOTE_MAX_BYTES=8000000000
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
RCLONE_CONFIG_OFFSITE_REGION=auto
# An object-scoped token cannot HeadBucket/CreateBucket, which rclone tries
# before its first write (rclone's R2 notes); the bucket already exists.
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
# rclone would otherwise look for (and warn about) a config file in a home
# directory the unit cannot see.
RCLONE_CONFIG=/dev/null
# Before off-host storage exists, and only then: BACKUP_REMOTE=none
