# /etc/xtelo/backup.env — the nightly backup (xtelo-backup).
# Mode 0600, owner xtelo. Placeholders only: never commit a real value.

# A role that can read every table: the owner or a dedicated backup role, never public.
BACKUP_DATABASE_URL=postgres://<BACKUP_ROLE>:<PASSWORD>@<DB_HOST>:5432/scraplify
BACKUP_DIR=/var/backups/xtelo
BACKUP_RETENTION_COUNT=14
