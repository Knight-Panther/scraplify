# /etc/xtelo/migration.env — schema migrations only
# (deploy/with-env.sh migration npm run db:migrate). No unit reads this file;
# no running process ever holds this credential.
# Mode 0600, owner root. Placeholders only: never commit a real value.

# scraplify_migration (scripts/sql/phase-8b-worker-admin-migration-roles.sql, §3).
# deploy/apply-db-roles.sh creates the role with this password: letters and
# digits only (openssl rand -hex 32).
DATABASE_URL=postgres://scraplify_migration:<MIGRATION_ROLE_PASSWORD>@<DB_HOST>:5432/scraplify
