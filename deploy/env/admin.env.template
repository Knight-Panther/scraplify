# /etc/xtelo/admin.env — the admin web process (xtelo-web@admin).
# Mode 0640, owner root, group xtelo. Placeholders only: never commit a real value.
#
# It refuses to start (web/instrumentation.ts) unless all four auth values are
# set, the secret is at least 32 characters and every admin id is numeric.

XTELO_SURFACE=admin
XTELO_PORT=3001

# scraplify_admin only (scripts/sql/phase-8b-worker-admin-migration-roles.sql).
DATABASE_URL=postgres://scraplify_admin:<ADMIN_ROLE_PASSWORD>@<DB_HOST>:5432/scraplify

# The production GitHub OAuth app. Callback URL:
# https://<ADMIN_HOST>/api/auth/callback/github
AUTH_GITHUB_ID=<GITHUB_OAUTH_CLIENT_ID>
AUTH_GITHUB_SECRET=<GITHUB_OAUTH_CLIENT_SECRET>
# openssl rand -base64 32
AUTH_SECRET=<RANDOM_44_CHARACTERS>
AUTH_URL=https://<ADMIN_HOST>
# GitHub numeric user ids (https://api.github.com/users/<name> -> "id"), comma-separated.
ADMIN_GITHUB_IDS=<NUMERIC_ID>

# Admin review actions write (duplicates, taxonomy). Every one is audited.
XTELO_WRITES_ENABLED=true

LOG_LEVEL=info
